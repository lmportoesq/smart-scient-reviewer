# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scientificguard

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API Port
PORT=3001

# AI Provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_API_KEY=

# External APIs
CROSSREF_API_URL=https://api.crossref.org
CROSSREF_MAILTO=your-email@example.com
OPENALEX_API_URL=https://api.openalex.org
NCBI_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# File Upload
MAX_UPLOAD_SIZE_MB=20

# Seed Users (passwords for prisma seed)
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_PASSWORD=

# Node Environment
NODE_ENV=development
