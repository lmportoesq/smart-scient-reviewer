generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REVIEWER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  EXTRACTION_FAILED
}

enum AnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum VerificationStatus {
  VERIFIED
  PARTIAL_MATCH
  NOT_FOUND
  MISMATCH
  ALERT
  NOT_APPLICABLE
  ERROR
}

enum SignalSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ReviewPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewDecision {
  APPROVE
  REJECT
  NEEDS_MORE_REVIEW
}

enum SupportLevel {
  SUPPORTED
  PARTIAL
  UNSUPPORTED
  PENDING_REVIEW
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(REVIEWER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reviews   Review[]
  auditLogs AuditLog[]

  @@map("users")
}

model Paper {
  id              String          @id @default(uuid())
  title           String?
  doi             String?
  pmid            String?
  journal         String?
  publicationYear Int?
  authors         Json?
  analysisStatus  AnalysisStatus  @default(PENDING)
  reviewPriority  ReviewPriority?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  documents     Document[]
  verifications Verification[]
  evidences     Evidence[]
  aiAnalyses    AIAnalysis[]
  claims        Claim[]
  reviews       Review[]
  auditLogs     AuditLog[]

  @@map("papers")
}

model Document {
  id             String         @id @default(uuid())
  paperId        String
  originalName   String
  storedFilename String
  mimeType       String
  sizeBytes      Int
  status         DocumentStatus @default(UPLOADED)
  extractedText  Json?
  extractedMeta  Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  paper Paper @relation(fields: [paperId], references: [id])

  @@map("documents")
}

model Verification {
  id          String             @id @default(uuid())
  paperId     String
  provider    String
  signalType  String
  status      VerificationStatus
  severity    SignalSeverity?
  metadata    Json?
  rawResponse Json?
  cachedAt    DateTime?
  createdAt   DateTime           @default(now())

  paper Paper @relation(fields: [paperId], references: [id])

  @@map("verifications")
}

model Evidence {
  id           String         @id @default(uuid())
  paperId      String
  signalId     String
  severity     SignalSeverity
  title        String
  source       String
  sourceUrl    String?
  evidenceData Json
  createdAt    DateTime       @default(now())

  paper Paper @relation(fields: [paperId], references: [id])

  @@map("evidences")
}

model AIAnalysis {
  id          String         @id @default(uuid())
  paperId     String
  provider    String
  model       String
  summary     String?
  methodology Json?
  rawInput    Json?
  rawOutput   Json?
  validated   Boolean        @default(false)
  status      AnalysisStatus @default(PENDING)
  durationMs  Int?
  createdAt   DateTime       @default(now())

  paper Paper @relation(fields: [paperId], references: [id])

  @@map("ai_analyses")
}

model Claim {
  id               String       @id @default(uuid())
  paperId          String
  aiAnalysisId     String?
  claim            String
  page             Int?
  supportingText   String?
  supportLevel     SupportLevel
  confidence       Float?
  needsHumanReview Boolean      @default(true)
  createdAt        DateTime     @default(now())

  paper Paper @relation(fields: [paperId], references: [id])

  @@map("claims")
}

model Review {
  id         String         @id @default(uuid())
  paperId    String
  reviewerId String
  decision   ReviewDecision
  reason     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  paper    Paper @relation(fields: [paperId], references: [id])
  reviewer User  @relation(fields: [reviewerId], references: [id])

  @@map("reviews")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  paperId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  paper Paper? @relation(fields: [paperId], references: [id])

  @@map("audit_logs")
}
